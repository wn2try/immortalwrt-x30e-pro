## /etc/uci-defaults/99-custom 
## removed after execution with exit 0


# timezone
uci set system.@system[0].timezone="CST-8"
uci set system.@system[0].zonename="Asia/Shanghai"
uci set system.ntp.server='ntp.tencent.com ntp.aliyun.com time.apple.com'
uci commit system


# language
uci set luci.main.lang='zh_cn'
uci commit luci


# enable HFO
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall


# enable upnpd
uci set upnpd.config.enabled='1'
uci commit upnpd


# feeds
sed -E -e '/routing|telephony|video/s/^/#/' \
    -e 's|mirrors.vsean.net/openwrt|downloads.immortalwrt.org|' \
    -i /etc/apk/repositories.d/distfeeds.list


exit 0
